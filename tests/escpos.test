## graphics by key code

test nv_graphics_print-1 {GS ( L fn=69} { hex [nv_graphics_print A1] } 1d284c0600304541310101
test nv_graphics_print-2 {GS ( L fn=69 doubled} { hex [nv_graphics_print A1 2 2] } 1d284c0600304541310202
test nv_graphics_delete-1 {GS ( L fn=65} { hex [nv_graphics_delete] } 1d284c05003041434c52
test nv_graphics_delete-2 {GS ( L fn=66} { hex [nv_graphics_delete A1] } 1d284c040030424131
test dl_graphics_print-1 {GS ( L fn=85} { hex [dl_graphics_print A1] } 1d284c0600305541310101
test dl_graphics_delete-1 {GS ( L fn=81} { hex [dl_graphics_delete] } 1d284c05003051434c52
test dl_graphics_delete-2 {GS ( L fn=82} { hex [dl_graphics_delete A1] } 1d284c040030524131
test gsL-1 {GS 8 L for data larger than 65535 bytes} {
	set s [::escpos::_gsL [string repeat x 70000]]
	list [hex [string range $s 0 6]] [string length $s]
} {1d384c70110100 70007}
test kc-1 {key code must have 2 characters} -body {
	nv_graphics_print A
} -returnCodes error -match glob -result {*key code*}

## images: 10x9 image, black pixels at (0,0) (9,0) (0,8)

set png [testpng 10 9 {0 0 9 0 0 8}]

test img-1 {GS v 0, width aligned to 32 dots} -constraints tclgd -body {
	set h [hex [img $png]]
	list [string range $h 0 15] [string range $h 16 23] [string range $h 24 31] [string range $h end-7 end] [string length $h]
} -result {1d76300004000900 80400000 00000000 80000000 88}

test img-2 {GS ( L fn=112 + fn=50, width aligned to 8 dots} -constraints tclgd -body {
	## 16 dots -> 2 bytes/row, 9 rows = 18 bytes; payload 10 + 18 = 28
	set h [hex [img $png GSL]]
	list [string range $h 0 29] [string range $h 30 33] [string range $h end-13 end] [string length $h]
} -result {1d284c1c0030703001013110000900 8040 1d284c02003032 80}

test img-3 {raw mode unchanged} -constraints tclgd -body {
	lrange [img $png raw] 0 1
} -result {32 9}

test bitimg_esc-1 {ESC * 24-dot column bands} -constraints tclgd -body {
	set h [hex [bitimg_esc $png]]
	list [string range $h 0 5] [string range $h 6 15] [string range $h 16 21] [string range $h 22 27] [string range $h end-5 end] [string length $h]
} -result {1b3318 1b2a211000 808000 000000 0a1b32 118}

test bitimg_dl_define-1 {GS * column format} -constraints tclgd -body {
	set h [hex [bitimg_dl_define $png]]
	## x=2 (16 dots), y=2 (16 dots): 16 columns * 2 bytes
	list [string range $h 0 7] [string range $h 8 15] [string range $h 44 47] [string length $h]
} -result {1d2a0202 80800000 8000 72}

test bitimg_nv_define-1 {FS q with two images} -constraints tclgd -body {
	set h [hex [bitimg_nv_define $png $png]]
	list [string range $h 0 5] [string range $h 6 13] [string range $h 14 21] [string length $h]
} -result {1c7102 02000200 80800000 150}

test nv_graphics_define-1 {GS ( L fn=67 raster format} -constraints tclgd -body {
	set h [hex [nv_graphics_define A1 $png]]
	## 16 dots -> 2 bytes/row, 9 rows = 18 bytes; payload 11 + 18 = 29
	list [string range $h 0 29] [string range $h 30 31] [string length $h]
} -result {1d284c1d0030433041310110000900 31 68}

test dl_graphics_define-1 {GS ( L fn=83} -constraints tclgd -body {
	string range [hex [dl_graphics_define A1 $png]] 0 15
} -result 1d284c1d00305330

file delete $png

## templates parse without errors

foreach tmpl {align barcodetest font lorem rot90 subst qrcode_native pdf417} {
	test template-$tmpl "template tmpl_$tmpl.txt parses" -body {
		set text [eptmpl::readfile [file join $::basedir templates tmpl_$tmpl.txt]]
		string length [eptmpl::parse $text]
	} -match glob -result {[1-9]*}
}

cleanupTests
