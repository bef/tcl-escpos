## byte-level tests for the escpos command library
## run: tclsh tests/escpos.test

package require tcltest
namespace import ::tcltest::*

set basedir [file dirname [file dirname [file normalize [info script]]]]
source [file join $basedir eptmpl.tcl]
namespace import ::escpos::*

proc hex {s} {
	binary scan $s H* h
	return $h
}

## write a w*h PNG with the given black pixels to a temp file, return its name
proc testpng {w h pixels} {
	GD create_truecolor tpng $w $h
	set white [tpng allocate_color 255 255 255]
	set black [tpng allocate_color 0 0 0]
	tpng filled_rectangle 0 0 [expr {$w-1}] [expr {$h-1}] $white
	foreach {x y} $pixels { tpng pixel $x $y $black }
	set fp [file tempfile fn]
	fconfigure $fp -translation binary
	puts -nonewline $fp [tpng png_data 9]
	close $fp
	tpng delete
	return $fn
}

testConstraint tclgd [expr {[info commands ::GD] ne ""}]

## fixed commands

test barcode-1 {GS k function A ends with NUL} {
	hex [barcode 4 AB]
} 1d6b04414200
test barcode-2 {GS k function B sends byte length (Tcl 9 safe)} {
	hex [barcode 73 "\{B123"]
} 1d6b49057b42313233

test rel_pos-1 {ESC \ positive} {
	hex [rel_pos 300]
} 1b5c2c01
test rel_pos-2 {ESC \ negative uses two's complement} {
	hex [rel_pos -10]
} 1b5cf6ff
test set_abs_pos-1 {ESC $} {
	hex [set_abs_pos 256]
} 1b240001

test set_font-1 {ESC M font A} {
	hex [set_font 0]
} 1b4d00
test set_font-2 {ESC M with ASCII digit} {
	hex [set_font 48]
} 1b4d30
test set_font-3 {ESC M font C} {
	hex [set_font 2]
} 1b4d02
test set_font-4 {ESC M extended font} {
	hex [set_font 97]
} 1b4d61
test set_font-5 {ESC ! list mode, no stdout output} -body {
	hex [set_font b e q u]
} -result 1b21b9 -output {}
test set_font-6 {ESC ! hex mode} {
	hex [set_font 0x3E]
} 1b213e
test set_font-7 {ESC ! reset} -body {
	hex [set_font]
} -result 1b2100 -output {}

test cut-1 {GS V function A} {
	hex [cut]
} 1d5600
test cut-2 {GS V function A partial} {
	hex [cut 1]
} 1d5601
test cut-3 {GS V function B} {
	hex [cut 66 3]
} 1d564203
test cut-4 {GS V function C} {
	hex [cut 97 5]
} 1d566105
test cut-5 {GS V function D} {
	hex [cut 104 0]
} 1d566800

test bwinv-1 {GS B off, both spellings} {
	list [hex [unset_bwinv]] [hex [unset_wbinv]]
} {1d4200 1d4200}

test dm-1 {US B} { hex [dm_cur_end] } 1f42
test dm-2 {US CR} { hex [dm_cur_line_end] } 1f0d
test dm-3 {US LF} { hex [dm_cur_up] } 1f0a

test umlautmap-1 {code page 437 umlauts, nothing appended} {
	hex [eptmpl::umlautmap "aäÖß"]
} 618499e1

## 2D codes

test qrcode-1 {GS ( k QR code with defaults} {
	hex [qrcode AB]
} [join {
	1d286b0400314132 00
	1d286b0300314306
	1d286b0300314531
	1d286b0500315030 4142
	1d286b0300315130
} ""]
test qrcode-2 {GS ( k QR code options} {
	string range [hex [qrcode A 3 H 1]] 0 47
} 1d286b0400314131001d286b03003143031d286b03003145
test qrcode-3 {GS ( k QR store length is data + 3} {
	string range [hex [qrcode [string repeat x 300]]] 50 63
} 1d286b2f013150
test qrcode-4 {invalid error correction level} -body {
	qrcode A 6 X
} -returnCodes error -match glob -result {*error correction*}

test pdf417-1 {GS ( k PDF417 with defaults} {
